<Window x:Class="MinimalBrowserShell.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Minimal Browser" Width="1200" Height="800" MinWidth="400" MinHeight="300"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="AddressBar" Grid.Row="0" Padding="6,4" Background="#F3F3F3" Visibility="Collapsed">
            <TextBox x:Name="AddressInput" KeyDown="AddressInput_KeyDown" LostKeyboardFocus="AddressInput_LostKeyboardFocus" />
        </Border>
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Window>
